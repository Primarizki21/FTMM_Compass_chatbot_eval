# Salin menjadi .env di folder project, lalu isi. File .env tidak boleh dibagikan atau diunggah.

# --- 9Router (OpenAI-compatible, wajib lewat tunnel tim) ---
# Tunnel dipakai agar evaluasi memakai jalur akses yang sama dengan anggota tim lain.
# Host boleh dengan atau tanpa akhiran /v1; request dikirim ke <host>/v1/chat/completions.
NINE_ROUTER_HOST=https://<tunnel-tim>.abc-tunnel.us
# Wajib memakai prefix provider 9router (ag/gemini-...); tanpa prefix akan 404.
NINE_ROUTER_MODEL=<prefix-provider>/<model>
# Key terbitan dashboard 9router. Kunci Google Gemini ditolak (API_KEY_INVALID).
NINE_ROUTER_API_KEY=

# --- OpenAI langsung (opsional) ---
# Model harus tersedia untuk key ini; gpt-6-luna = varian termurah/tercepat keluarga GPT-6.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-6-luna
# Tanpa akhiran /v1 tetap diterima; request dikirim ke <host>/v1/chat/completions.
OPENAI_BASE_URL=https://api.openai.com/v1
# "none" mematikan reasoning agar temperature/top_p berlaku. low/medium/high mengaktifkan reasoning;
# temperature/top_p otomatis tidak dikirim dan batas keluaran menjadi OPENAI_REASONING_MAX_TOKENS.
OPENAI_REASONING_EFFORT=low

# --- Gemini langsung (opsional, untuk pembanding) ---
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# --- Ollama lokal (LLM lokal dan embedding) ---
LLM_MODEL_NAME=llama3.2:3b
EMBED_MODEL_NAME=nomic-embed-text-v2-moe
OLLAMA_HOST=http://127.0.0.1:11434
